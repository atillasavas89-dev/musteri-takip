// ====================
// UTILITY FUNCTIONS
// ====================
function changeMonth(delta) {
    currentDate.setMonth(currentDate.getMonth() + delta);
    updateDisplay();
}

function switchView(view) {
    currentView = view;
    els.btnMonthly.classList.toggle('active', view === 'monthly');
    els.btnCumulative.classList.toggle('active', view === 'cumulative');
    updateDisplay();
}

function getMonthKey(date) {
    return `${date.getFullYear()}-${date.getMonth()}`;
}

// ====================
// CORE LOGIC
// ====================
function updateDisplay() {
    const trMonth = currentDate.toLocaleString('tr-TR', { month: 'long', year: 'numeric' });
    els.currentMonthDisplay.textContent = trMonth;

    const searchTerm = els.searchInput.value.toLowerCase();
    const filteredCustomers = customers.filter(c => {
        const matchesSearch = c.name.toLowerCase().includes(searchTerm);
        const matchesStatus = statusFilter === 'all' || c.status === statusFilter;
        return matchesSearch && matchesStatus;
    });

    if (currentView === 'monthly') {
        renderMonthlyView(filteredCustomers);
    } else {
        renderCumulativeView(filteredCustomers);
    }
}

function renderMonthlyView(filteredCustomers) {
    els.customerTableBody.innerHTML = '';
    const monthKey = getMonthKey(currentDate);

    let stats = {
        submitted: 0,
        pending: 0,
        receivable: 0,
        collected: 0,
        active: 0
    };

    filteredCustomers.forEach(customer => {
        if (customer.status === 'Active') stats.active++;

        const feeStatus = customer.feeHistory?.[monthKey] || 'unpaid';
        const monthlyFee = parseFloat(customer.monthlyFee) || 0;

        if (feeStatus === 'paid') {
            stats.collected += monthlyFee;
        } else {
            stats.receivable += monthlyFee;
        }

        const requiredDecs = getRequiredDeclarations(customer, currentDate);
        const completedDecs = customer.declarationHistory?.[monthKey] || [];

        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <div style="font-weight: 500;">${customer.name}</div>
                <div style="font-size: 0.8rem; color: #a0a0b0;">${customer.taxId}</div>
            </td>
            <td>${monthlyFee.toLocaleString('tr-TR')} ₺</td>
            <td>
                <label class="checkbox-group" style="padding: 0.25rem; border: none; background: none;">
                    <input type="checkbox" 
                        ${feeStatus === 'paid' ? 'checked' : ''} 
                        onchange="toggleFee('${customer.id}', '${monthKey}', this.checked)">
                    <span style="font-size: 0.9rem;">${feeStatus === 'paid' ? 'Ödendi' : 'Ödenmedi'}</span>
                </label>
            </td>
            <td><span class="status-badge ${customer.status.toLowerCase()}">${customer.status === 'Active' ? 'Aktif' : 'Kapalı'}</span></td>
            <td>
                <div style="display: flex; flex-wrap: wrap;">
                    ${requiredDecs.map(dec => {
            const isDone = completedDecs.includes(dec);
            if (isDone) stats.submitted++; else stats.pending++;
            const deadline = DECLARATION_TYPES[dec].deadline;
            return `
                            <div class="declaration-tag ${isDone ? 'completed' : ''}" 
                                 onclick="toggleDeclaration('${customer.id}', '${monthKey}', '${dec}')"
                                 title="Son Tarih: ${deadline} ${trMonth}">
                                <input type="checkbox" ${isDone ? 'checked' : ''}>
                                ${DECLARATION_TYPES[dec].name} (${deadline})
                            </div>
                        `;
        }).join('')}
                </div>
            </td>
            <td>
                <button class="action-btn" onclick="editCustomer('${customer.id}')"><i class="fa-solid fa-pen"></i></button>
                <button class="action-btn" onclick="deleteCustomer('${customer.id}')" style="color: var(--danger);"><i class="fa-solid fa-trash"></i></button>
            </td>
        `;
        els.customerTableBody.appendChild(row);
    });

    els.totalSubmitted.textContent = stats.submitted;
    els.totalPending.textContent = stats.pending;
    els.totalReceivable.textContent = stats.receivable.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';
    els.totalCollected.textContent = stats.collected.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';
    els.activeCustomerCount.textContent = stats.active;
}

function renderCumulativeView(filteredCustomers) {
    els.customerTableBody.innerHTML = `
        <tr>
            <td colspan="6" style="text-align: center; padding: 2rem;">
                <i class="fa-solid fa-chart-line" style="font-size: 2rem; color: var(--accent-blue); margin-bottom: 1rem;"></i>
                <p>Kümülatif görünüm geliştirilme aşamasındadır.</p>
                <p>Şu an için aylık bazda toplam alacak: ${els.totalReceivable.textContent}</p>
            </td>
        </tr>
    `;
}

// ====================
// ACTIONS
// ====================
function toggleFee(customerId, monthKey, isPaid) {
    const customer = customers.find(c => c.id === customerId);
    if (!customer.feeHistory) customer.feeHistory = {};
    customer.feeHistory[monthKey] = isPaid ? 'paid' : 'unpaid';
    updateCustomerField(customerId, 'feeHistory', customer.feeHistory);
}

function toggleDeclaration(customerId, monthKey, type) {
    const customer = customers.find(c => c.id === customerId);
    if (!customer.declarationHistory) customer.declarationHistory = {};
    if (!customer.declarationHistory[monthKey]) customer.declarationHistory[monthKey] = [];

    const list = customer.declarationHistory[monthKey];
    if (list.includes(type)) {
        customer.declarationHistory[monthKey] = list.filter(t => t !== type);
    } else {
        list.push(type);
    }
    updateCustomerField(customerId, 'declarationHistory', customer.declarationHistory);
}

function deleteCustomer(id) {
    if (confirm('Bu müşteriyi silmek istediğinize emin misiniz?')) {
        deleteCustomerFromDB(id);
    }
}

function editCustomer(id) {
    const customer = customers.find(c => c.id === id);
    if (!customer) return;

    const form = els.addCustomerForm;
    form.dataset.editId = id;

    form.name.value = customer.name;
    form.companyType.value = customer.companyType;
    form.address.value = customer.address || '';
    form.phone.value = customer.phone || '';
    form.email.value = customer.email || '';
    form.taxId.value = customer.taxId;
    form.taxOffice.value = customer.taxOffice || '';
    form.mersis.value = customer.mersis || '';
    form.tradeRegistry.value = customer.tradeRegistry || '';
    form.monthlyFee.value = customer.monthlyFee || '';
    form.openingDate.value = customer.openingDate || '';
    form.hasEmployees.value = customer.hasEmployees;
    form.eLedger.value = customer.eLedger;

    const checkboxes = form.querySelectorAll('input[name="declarations"]');
    checkboxes.forEach(cb => cb.checked = customer.declarations.includes(cb.value));

    els.partnersContainer.innerHTML = '';
    if (customer.partners && customer.partners.length > 0) {
        customer.partners.forEach(p => {
            const div = document.createElement('div');
            div.className = 'partner-row';
            div.innerHTML = `
                <input type="text" placeholder="Ad Soyad" class="partner-name" value="${p.name}">
                <input type="text" placeholder="TC No" class="partner-tc" value="${p.tc}">
            `;
            els.partnersContainer.appendChild(div);
        });
    } else {
        addPartnerField();
    }

    openModal();
}

