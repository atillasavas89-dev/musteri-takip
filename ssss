// ====================
// FIREBASE OPERATIONS
// ====================
function loadCustomers() {
    // Real-time listener for customers
    customersRef.onSnapshot((snapshot) => {
        customers = [];
        snapshot.forEach((doc) => {
            customers.push({ id: doc.id, ...doc.data() });
        });
        updateDisplay();
    }, (error) => {
        console.error("Error loading customers:", error);
        alert("Veriler yüklenirken hata oluştu. Lütfen sayfayı yenileyin.");
    });
}

async function saveCustomer(customerData) {
    try {
        if (customerData.id && customerData.id !== 'new') {
            // Update existing
            await customersRef.doc(customerData.id).update(customerData);
        } else {
            // Add new
            delete customerData.id;
            await customersRef.add(customerData);
        }
    } catch (error) {
        console.error("Error saving customer:", error);
        alert("Müşteri kaydedilirken hata oluştu!");
    }
}

async function deleteCustomerFromDB(id) {
    try {
        await customersRef.doc(id).delete();
    } catch (error) {
        console.error("Error deleting customer:", error);
        alert("Müşteri silinirken hata oluştu!");
    }
}

async function updateCustomerField(id, field, value) {
    try {
        await customersRef.doc(id).update({ [field]: value });
    } catch (error) {
        console.error("Error updating customer:", error);
    }
}

// ====================
// DECLARATION LOGIC
// ====================
const DECLARATION_TYPES = {
    'KDV': { name: 'KDV', deadline: 28 },
    'KDV2': { name: 'KDV 2', deadline: 28 },
    'MUHSGK': { name: 'MUHSGK', deadline: 26 },
    'GECICI': { name: 'Geçici', deadline: 17 },
    'YILLIK': { name: 'Yıllık', deadline: 30 },
    'EDEFTER': { name: 'E-Defter', deadline: 30 }
};

function getRequiredDeclarations(customer, date) {
    const month = date.getMonth();
    const required = [];

    if (customer.declarations.includes('KDV')) required.push('KDV');
    if (customer.declarations.includes('KDV2')) required.push('KDV2');

    if (customer.declarations.includes('MUHSGK')) {
        if (customer.hasEmployees === 'yes') {
            required.push('MUHSGK');
        } else {
            if ([0, 3, 6, 9].includes(month)) {
                required.push('MUHSGK');
            }
        }
    }

    if (customer.declarations.includes('GECICI')) {
        if ([1, 4, 7, 10].includes(month)) {
            required.push('GECICI');
        }
    }

    if (customer.declarations.includes('YILLIK')) {
        if (customer.companyType === 'sahis' || customer.companyType === 'sahis_bilanco') {
            if (month === 2) required.push('YILLIK');
        } else {
            if (month === 3) required.push('YILLIK');
        }
    }

    if (customer.declarations.includes('EDEFTER') && customer.eLedger !== 'none') {
        if (customer.eLedger === 'monthly') {
            required.push('EDEFTER');
        } else if (customer.eLedger === 'quarterly') {
            if ([1, 4, 7, 10].includes(month)) {
                required.push('EDEFTER');
            }
        }
    }

    return required;
}

