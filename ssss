    background-color: var(--bg-dark);
    border: 1px solid var(--border);
    margin-right: 0.5rem;
    margin-bottom: 0.25rem;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
}

.declaration-tag:hover {
