    div.className = 'partner-row';
    div.innerHTML = `
        <input type="text" placeholder="Ad Soyad" class="partner-name">
        <input type="text" placeholder="TC No" class="partner-tc">
    `;
    els.partnersContainer.appendChild(div);
}

async function handleFormSubmit(e) {
    e.preventDefault();
    const formData = new FormData(e.target);

    const partners = [];
    const pNames = e.target.querySelectorAll('.partner-name');
    const pTcs = e.target.querySelectorAll('.partner-tc');
    pNames.forEach((input, i) => {
        if (input.value) partners.push({ name: input.value, tc: pTcs[i].value });
    });

    const customerData = {
        id: e.target.dataset.editId || 'new',
        name: formData.get('name'),
        companyType: formData.get('companyType'),
        address: formData.get('address'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        taxId: formData.get('taxId'),
        taxOffice: formData.get('taxOffice'),
        mersis: formData.get('mersis'),
        tradeRegistry: formData.get('tradeRegistry'),
        partners: partners,
        monthlyFee: formData.get('monthlyFee'),
        openingDate: formData.get('openingDate'),
        hasEmployees: formData.get('hasEmployees'),
        eLedger: formData.get('eLedger'),
        declarations: formData.getAll('declarations'),
        status: 'Active',
        feeHistory: {},
        declarationHistory: {}
    };

    if (e.target.dataset.editId) {
        const existing = customers.find(c => c.id === customerData.id);
        customerData.feeHistory = existing.feeHistory || {};
        customerData.declarationHistory = existing.declarationHistory || {};
    }

    await saveCustomer(customerData);
    closeModal();
}

